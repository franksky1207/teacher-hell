{
  "name": "teacher-hell",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "calendar:cohort-check": "node scripts/three-year-calendar-check.js",
    "check": "node scripts/project.js check",
    "build": "node scripts/project.js build",
    "preview": "node scripts/project.js preview",
    "test": "node scripts/project.js test regression",
    "test:unit": "node scripts/project.js test unit",
    "test:contract": "node scripts/project.js test contract",
    "test:integration": "node scripts/project.js test integration",
    "test:scenario": "node scripts/project.js test scenario",
    "test:tooling": "node scripts/project.js test tooling",
    "test:quick": "node scripts/project.js test quick",
    "test:module": "node scripts/project.js test",
    "test:coverage": "node scripts/project.js test regression --coverage",
    "verify:quick": "npm run check && npm run test:quick && npm run build",
    "test:browser": "npm run build && node scripts/browser-smoke.js",
    "test:storage:browser": "npm run build && node scripts/storage-browser.js",
    "demo:story": "node scripts/story-demo.js",
    "test:story:routes": "node scripts/story-demo.js --regression",
    "test:story:browser": "npm run build && node scripts/storage-browser.js --story-only",
    "demo:npc": "node scripts/story-demo.js --npc",
    "test:npc:routes": "node scripts/story-demo.js --npc --regression",
    "demo:school": "node scripts/school-demo.js",
    "simulate:school": "node --expose-gc simulation/school-academics.js",
    "demo:procedures": "node scripts/procedure-demo.js",
    "simulate:procedures": "node --expose-gc simulation/institution-history.js",
    "demo:reviews": "node scripts/review-demo.js",
    "demo:annual": "node scripts/annual-demo.js",
    "test:annual:browser": "npm run build && node scripts/storage-browser.js --annual",
    "demo:failure": "node scripts/failure-demo.js",
    "test:failure:browser": "npm run build && node scripts/storage-browser.js --failure-only",
    "test:academic": "node scripts/project.js test academic",
    "test:game:browser": "npm run build && node scripts/game-browser.js",
    "deploy:preview": "bash scripts/deploy-preview.sh",
    "test:senior:continuous": "node --max-old-space-size=4096 --expose-gc scripts/senior-integration.js",
    "test:senior:save": "node --max-old-space-size=4096 --expose-gc scripts/senior-verify-save.js",
    "test:senior:browser": "npm run build && node scripts/senior-browser.js",
    "content:audit": "node scripts/audit-content.mjs",
    "content:audit:strict": "node scripts/audit-content.mjs --strict",
    "content:draft-check": "node scripts/check-story-draft.mjs",
    "content:production": "node scripts/manage-story-production.mjs",
    "test:story-draft": "node --test test/story-draft-validator.test.js",
    "test:production-ledger": "node --test test/story-production-ledger.test.js"
  },
  "devDependencies": {
    "acorn": "8.15.0"
  }
}
