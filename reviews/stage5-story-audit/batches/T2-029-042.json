  "findings": [
    {
      "findingId": "F-T2-033-01",
      "term": "T2",
      "storyId": "T2-033",
      "severity": "B",
      "category": "AVG表情對象錯誤/P02表情指向錯誤角色",
      "file": "content/events-v1/T/T2-高一下/T2-1-班呼／校歌比賽前後/活動後/T2-033.md",
      "location": "AVG / P02",
      "excerpt": "P02 [{{student_a.name}}] (avg: {\"expression\":{\"student_b\":\"sad\"}}): 「那不是什麼好笑的梗，我真的不想再讓大家看一次。」",
      "description": "P02 由 `student_a` 說出「那不是什麼好笑的梗，我真的不想再讓大家看一次」，但 `expression` 卻設定在 `student_b`（`\"student_b\":\"sad\"`），導致正在難過的說話者 `student_a` 仍維持 `calm`，而想播影片的 `student_b` 卻突然變成 `sad`。",
      "rationale": "表情對象與說話者及當頁情緒完全相反，屬於明確的 AVG 角色表情指派錯誤。",
      "sopReference": "03主流程 D / 05品質契約 四",
      "suggestedFix": "將 P02 的 `expression` 改為 `{\"student_a\":\"sad\"}`。",
      "preserveContent": "保留 P01-P03 的台詞與情境敘述。",
      "syncAvg": true,
      "step2FixStatus": "尚未修正",
      "step2VerifyStatus": "尚未驗收"
    },
    {
      "findingId": "F-T2-036-01",
      "term": "T2",
      "storyId": "T2-036",
      "severity": "B",
      "category": "AVG表情對象錯誤/P02表情指向錯誤角色",
      "file": "content/events-v1/T/T2-高一下/T2-1-班呼／校歌比賽前後/活動後/T2-036.md",
      "location": "AVG / P02",
      "excerpt": "P02 [{{student_a.name}}] (avg: {\"expression\":{\"student_b\":\"sad\"}}): 「我沒站上去不代表我什麼都沒做，可是我不想一直解釋。」",
      "description": "P02 由 `student_a` 委屈發言「我沒站上去不代表我什麼都沒做，可是我不想一直解釋」，但 `expression` 卻設定在 `student_b`（`\"student_b\":\"sad\"`）。",
      "rationale": "表情對象與說話者錯置，使委屈的說話者維持 `calm`、質疑者反而變成 `sad`。",
      "sopReference": "03主流程 D / 05品質契約 四",
      "suggestedFix": "將 P02 的 `expression` 改為 `{\"student_a\":\"sad\"}`。",
      "preserveContent": "保留 P01-P03 的台詞與情境敘述。",
      "syncAvg": true,
      "step2FixStatus": "尚未修正",
      "step2VerifyStatus": "尚未驗收"
    },
    {
      "findingId": "F-T2-037-01",
      "term": "T2",
      "storyId": "T2-037",
      "severity": "B",
      "category": "AVG表情對象錯誤/P02表情指向錯誤角色",
      "file": "content/events-v1/T/T2-高一下/T2-1-班呼／校歌比賽前後/活動後/T2-037.md",
      "location": "AVG / P02",
      "excerpt": "P02 [{{student_a.name}}] (avg: {\"expression\":{\"student_b\":\"sad\"}}): 「我們表演都公開了，難道別人聽到還要先問嗎？」",
      "description": "P02 由 `student_a` 反問「我們表演都公開了，難道別人聽到還要先問嗎？」，但 `expression` 卻設定在 `student_b`（`\"student_b\":\"sad\"`），且 `student_a` 此句語氣偏向不解／委屈而非 `calm`。",
      "rationale": "表情對象錯置在未發言的 `student_b` 身上，與說話者 `student_a` 脫節。",
      "sopReference": "03主流程 D / 05品質契約 四",
      "suggestedFix": "將 P02 的 `expression` 改為 `{\"student_a\":\"sad\"}`（或 `surprised`）。",
      "preserveContent": "保留 P01-P03 的台詞與情境敘述。",
      "syncAvg": true,
      "step2FixStatus": "尚未修正",
      "step2VerifyStatus": "尚未驗收"
    }
